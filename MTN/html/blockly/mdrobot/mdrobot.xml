<!--引用所有写好的模块-->


<!-- 加入自定义菜单 -->
<category name="铭迪机器人" colour="100">



<category name="执行模块" colour="100">

<!-- LED灯 -->
<block type="mdbot_led">
    <value name="STAT">
      <shadow type="inout_highlow"></shadow>
    </value>
</block>
<!-- LED灯颜色调节 -->
<block type="mdbot_RGB">
	<value name="RGB_value1">
		<shadow type="math_number">
				<field name="NUM">0</field>
		</shadow>
	</value>
	<value name="RGB_value2">
		<shadow type="math_number">
				<field name="NUM">0</field>
		</shadow>
	</value>
	<value name="RGB_value3">
		<shadow type="math_number">
				<field name="NUM">0</field>
		</shadow>
	</value>
</block>
<!-- 蜂鸣器播放 -->
<block type="mdbot_tone_notes">
 <value name="FREQUENCY">
    <shadow type="tone_notes"></shadow>
  </value>
</block>
<!--蜂鸣器停止  -->
<block type="mdbot_tone_not"></block>
	<!-- 马达 -->
	<block type="mdbot_motor_A">
		<value name="speed">
			<shadow type="math_number">
				<field name="NUM">255</field>
			</shadow>
		</value>
	</block>

	
	
	<!-- 舵机 -->
	<block type="mdbot_servo_move_A">
	<value name="DEGREE">
<shadow type="math_number">
<field name="NUM">0</field>
</shadow>
</value>
<value name="DELAY_TIME">
<shadow type="math_number">
<field name="NUM">0</field>
</shadow>
</value>
	</block>
	<!--计时器初始化  -->
<block type="mdbot_jishiqi_chushi"></block>
		<!--计时器  -->
<block type="mdbot_jishiqi_jishi"></block>
<!--获取时钟时间-->
<block type="mdbot_d1302_get"></block>
<!--时钟设置年月日-->
<block type="mdbot_d1302_nyr">
  <value name="year">
    <shadow type="math_number">
      <field name="NUM">2000</field>
    </shadow>
  </value>
  <value name="month">
    <shadow type="math_number">
      <field name="NUM">1</field>
    </shadow>
  </value>
  <value name="day">
    <shadow type="math_number">
      <field name="NUM">1</field>
    </shadow>
  </value>
</block>
<!--时钟设置分秒时-->
<block type="mdbot_d1302_fms">
  <value name="hour">
    <shadow type="math_number">
      <field name="NUM">8</field>
    </shadow>
  </value>
  <value name="minute">
    <shadow type="math_number">
      <field name="NUM">0</field>
    </shadow>
  </value>
  <value name="second">
    <shadow type="math_number">
      <field name="NUM">0</field>
    </shadow>
  </value>
</block>

</category>

